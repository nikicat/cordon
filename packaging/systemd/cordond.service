# cordon gater — system unit (the hardened bpf-lsm boundary).
#
# Install:  cp to /etc/systemd/system/ && systemctl daemon-reload && systemctl
#           enable --now cordond
#
# Kernel and privilege requirements are in the README (Requirements). Needs the eBPF
# object installed (default /usr/lib/cordon/cordon.bpf.o). The daemon compiles the text
# policy at startup (/etc/cordon/policy.toml, or a /etc/cordon/conf.d/ directory of
# *.toml fragments) and seeds the in-kernel maps; `cordon policy apply` re-seeds at runtime. Operational
# settings come from /etc/cordon/config.toml (see packaging/cordon.example.toml).

[Unit]
Description=cordon gater (bpf-lsm in-kernel boundary)
# Start early so coverage begins before user sessions.
DefaultDependencies=no
After=local-fs.target
Before=basic.target
# The LSM links are pinned to bpffs so enforcement outlives this process; with
# DefaultDependencies=no nothing would otherwise order us after the mount. systemd's
# own sys-fs-bpf.mount provides it.
RequiresMountsFor=/sys/fs/bpf

[Service]
Type=simple
ExecStart=/usr/bin/cordond
Restart=on-failure
RestartSec=1
# NOTE: `systemctl stop cordond` does NOT stop enforcement (the pinned links hold it).
# There is deliberately no ExecStopPost teardown here: turning enforcement off is an
# explicit act, `cordond --teardown`, which refuses while the daemon is running.
AmbientCapabilities=CAP_BPF CAP_MAC_ADMIN
# A bless carrier cgroup (`cordon-bless-<id>.<class>`) goes under the requester's session
# scope or user slice, and under the daemon's own cgroup when neither is usable;
# Delegate=yes hands that subtree to the daemon so systemd doesn't fight its mkdir/rmdir
# there.
Delegate=yes

[Install]
WantedBy=basic.target
