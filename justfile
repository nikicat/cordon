# cordon task runner — https://just.systems  (install: `cargo install just`)
#
# Recipes are gated to the OS they apply to. The eBPF build is Linux-only because
# eBPF is a Linux-kernel facility; the planned macOS Endpoint Security backend is a
# separate build path and will get its own `[macos]` recipes here.

# List available recipes.
default:
    @just --list

# Build everything the boundary needs: the userspace workspace (core, daemon, cli,
# bpf-common) on stable, plus the eBPF object. The eBPF crate lives outside the workspace
# (pinned nightly + bpf-linker), so it takes its own cargo invocation — but the daemon
# *loads that object at runtime*, so a `build` that skipped it would leave you restarting
# the daemon onto a stale boundary with nothing to say so.
[linux]
[doc("Build the userspace workspace + the eBPF object (everything the daemon runs).")]
build:
    cargo build --workspace
    @{{ just_executable() }} build-ebpf

# Build the userspace workspace on stable. No eBPF object off Linux — eBPF is a
# Linux-kernel facility (see the header note); the workspace still compiles, just
# without a functional backend.
[macos]
[windows]
[doc("Build the userspace workspace on stable (no eBPF object off Linux).")]
build:
    cargo build --workspace

# Run the test suite + lints (what CI gates on).
test:
    cargo test --workspace
    cargo clippy --workspace --all-targets -- -D warnings
    cargo fmt --all --check

# Build the eBPF object and stage it at target/bpf/cordon.bpf.o (Linux only).
[linux]
build-ebpf:
    #!/usr/bin/env bash
    set -euo pipefail
    # Prerequisites (declared, not discovered):
    #   - pinned nightly + rust-src — crates/bpf/rust-toolchain.toml (auto-fetched)
    #   - bpf-linker on PATH — `cargo install bpf-linker`
    cd crates/bpf
    cargo build --release
    mkdir -p ../../target/bpf
    cp target/bpfel-unknown-none/release/cordon ../../target/bpf/cordon.bpf.o
    echo "staged eBPF object → target/bpf/cordon.bpf.o"

# Build the daemon (the bpf-lsm backend is on by default; Linux only).
[linux]
build-bpf-daemon:
    cargo build -p cordon-daemon

# Install + activate the LOCAL dev unit: this checkout's debug daemon, driven by the
# /etc/cordon layout, with `Delegate=yes` so bless carrier cgroups can be created under
# the daemon's own cgroup.
#
# The unit text is GENERATED here rather than copied from a checked-in file, deliberately:
# a copy is what silently drifted out of sync with /etc before (the tree's copy still
# named an old --config while /etc had moved to the /etc/cordon layout, so `cp`-ing it
# would have regressed the box). This recipe is the single source of truth.
#
# Not the packaged unit — that template is packaging/systemd/cordond.service and runs
# /usr/bin/cordond. Uses sudo, and restarts the daemon, so enforcement blips briefly.
[linux]
[doc("Install + activate the local dev cordond.service (sudo; restarts the daemon).")]
install-service:
    #!/usr/bin/env bash
    set -euo pipefail
    bin="{{ justfile_directory() }}/target/debug/cordond"
    [ -x "$bin" ] || { echo "missing $bin — run \`just build\` first" >&2; exit 1; }
    [ -f /etc/cordon/config.toml ] || echo "warning: no /etc/cordon/config.toml; the daemon will use built-in defaults" >&2
    sudo tee /etc/systemd/system/cordond.service >/dev/null <<'UNIT'
    # cordon gater — LOCAL dev/audit unit. GENERATED by `just install-service`.
    # Runs this checkout's debug binary against /etc/cordon/config.toml (→ conf.d).
    # Don't hand-edit: change the recipe in the justfile and re-run it.
    #
    #   journalctl -u cordond -f -o cat

    [Unit]
    Description=cordon gater (dev — bpf-lsm, /etc/cordon)
    After=local-fs.target

    [Service]
    Type=simple
    # No --config: root defaults to /etc/cordon/config.toml.
    ExecStart={{ justfile_directory() }}/target/debug/cordond
    # Runs as root, which already holds these; stated to mirror the production unit and
    # document the requirement (CAP_BPF loads the program + maps, CAP_MAC_ADMIN the hook).
    AmbientCapabilities=CAP_BPF CAP_MAC_ADMIN
    # The bless carrier cgroups (cordon-bless-<id>.<class>) are created under the daemon's
    # own cgroup; Delegate=yes hands it that subtree so systemd doesn't fight the
    # mkdir/rmdir there (DESIGN §16.6).
    Delegate=yes
    Restart=on-failure
    RestartSec=1
    Environment=RUST_LOG=info

    [Install]
    WantedBy=multi-user.target
    UNIT
    sudo systemctl daemon-reload
    sudo systemctl restart cordond
    sleep 0.5
    systemctl is-active --quiet cordond \
        && echo "cordond active — $(systemctl show -p FragmentPath --value cordond)" \
        || { echo "cordond failed to start:" >&2; journalctl -u cordond -n 20 --no-pager >&2; exit 1; }
