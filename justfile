# The cordon task runner (https://just.systems). Install just with `cargo install just`.
#
# Recipes are gated to the OS they apply to. The eBPF build is Linux-only because eBPF
# is a Linux-kernel facility. The planned macOS Endpoint Security backend is a separate
# build path and will get its own `[macos]` recipes here.

# The bpf-linker release that links the eBPF object, and the sha256 of its Linux x86_64
# tarball. Every build of the object uses this one, CI included. Bump both together.
bpf_linker_version := "v0.12.0"
bpf_linker_sha256 := "6789717c8cb6a2a5d920f3b6bfac2bd7efc00f6228ecd149108a99699a75c679"
bpf_linker_dir := justfile_directory() / "target/tools/bpf-linker-" + bpf_linker_version

# List available recipes.
default:
    @just --list

# Build the userspace workspace on stable and the eBPF object. The eBPF crate lives
# outside the workspace (it needs the pinned nightly and bpf-linker), so it takes its own
# cargo invocation. The daemon loads that object at runtime, so a `build` that skipped it
# would leave you restarting the daemon onto a stale boundary with nothing to say so.
[linux]
[doc("Build the userspace workspace + the eBPF object (everything the daemon runs).")]
build:
    cargo build --workspace
    @{{ just_executable() }} build-ebpf

# Build the userspace workspace on stable. Off Linux there is no eBPF object (see the
# header note), so the workspace compiles without a functional backend.
[macos]
[windows]
[doc("Build the userspace workspace on stable (no eBPF object off Linux).")]
build:
    cargo build --workspace

# Format both workspaces: the root one and the standalone eBPF crate. Extra arguments go
# to rustfmt.
fmt *args:
    cargo fmt --all -- {{ args }}
    cd crates/bpf && cargo fmt -- {{ args }}

# Check that both workspaces are rustfmt-clean.
fmt-check: (fmt "--check")

# Enable the tracked git hooks in .githooks, such as the pre-commit rustfmt check.
install-hooks:
    git config core.hooksPath .githooks

# Run the lints and the test suite. CI's `test` job runs this recipe.
test: fmt-check
    cargo clippy --workspace --all-targets --all-features -- -D warnings
    cargo test --workspace --all-features

# Build the eBPF object and stage it at target/bpf/cordon.bpf.o (Linux only).
[linux]
build-ebpf: bpf-linker
    #!/usr/bin/env bash
    set -euo pipefail
    # The pinned nightly and rust-src come from crates/bpf/rust-toolchain.toml, fetched
    # automatically. rustc's BPF target runs `bpf-linker` from PATH, so the pinned one
    # goes first.
    export PATH="{{ bpf_linker_dir }}:$PATH"
    cd crates/bpf
    cargo build --release
    mkdir -p ../../target/bpf
    cp target/bpfel-unknown-none/release/cordon ../../target/bpf/cordon.bpf.o
    echo "staged eBPF object → target/bpf/cordon.bpf.o"

# Fetch the pinned bpf-linker release into target/tools, unless it is there already. The
# release binary links its own LLVM, so it needs no system LLVM. Only the Linux x86_64
# tarball is pinned.
[linux]
bpf-linker:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{ bpf_linker_dir }}"
    [ -x "$dir/bpf-linker" ] && exit 0
    [ "$(uname -m)" = x86_64 ] || { echo "bpf-linker: only the x86_64 release is pinned" >&2; exit 1; }
    mkdir -p "{{ justfile_directory() }}/target/tools"
    tmp=$(mktemp -d "{{ justfile_directory() }}/target/tools/.fetch.XXXXXX")
    trap 'rm -rf "$tmp"' EXIT
    curl -fsSLo "$tmp/bpf-linker.tar.zst" \
        "https://github.com/aya-rs/bpf-linker/releases/download/{{ bpf_linker_version }}/bpf-linker-x86_64-unknown-linux-musl.tar.zst"
    echo "{{ bpf_linker_sha256 }}  $tmp/bpf-linker.tar.zst" | sha256sum -c --quiet
    tar -xpf "$tmp/bpf-linker.tar.zst" -C "$tmp"
    mkdir -p "$dir"
    mv "$tmp/bpf-linker" "$dir/bpf-linker"
    "$dir/bpf-linker" --version

# Install and activate the local dev unit. It is the packaged
# packaging/systemd/cordond.service, unchanged, plus a `cordond.service.d/dev.conf` drop-in
# that swaps in this checkout's debug daemon and a log level. Everything else comes from
# the production unit, so the two cannot drift.
#
# All privileged steps share one sudo. The recipe restarts the daemon, and enforcement does
# not blip, because the pinned links hold the boundary across the restart.
[linux]
[doc("Install + activate cordond.service with a dev drop-in for this checkout (sudo; restarts the daemon).")]
install-service:
    #!/usr/bin/env bash
    set -euo pipefail
    bin="{{ justfile_directory() }}/target/debug/cordond"
    [ -x "$bin" ] || { echo "missing $bin — run \`just build\` first" >&2; exit 1; }
    [ -f /etc/cordon/config.toml ] || echo "warning: no /etc/cordon/config.toml; the daemon will use built-in defaults" >&2
    dropin=$(mktemp)
    trap 'rm -f "$dropin"' EXIT
    cat >"$dropin" <<CONF
    # Generated by \`just install-service\`: run this checkout's debug daemon.
    [Service]
    ExecStart=
    ExecStart=$bin
    Environment=RUST_LOG=info
    CONF
    chmod 644 "$dropin"
    sudo sh -c '
        set -e
        install -m644 "$1" /etc/systemd/system/cordond.service
        install -Dm644 "$2" /etc/systemd/system/cordond.service.d/dev.conf
        systemctl daemon-reload
        systemctl restart cordond
    ' sh "{{ justfile_directory() }}/packaging/systemd/cordond.service" "$dropin"
    sleep 0.5
    systemctl is-active --quiet cordond \
        && echo "cordond active — $(systemctl show -p ExecStart --value cordond | grep -o 'path=[^ ;]*')" \
        || { echo "cordond failed to start:" >&2; journalctl -u cordond -n 20 --no-pager >&2; exit 1; }
